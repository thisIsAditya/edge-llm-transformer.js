{
  "name": "local-llm",
  "private": true,
  "description": "Local LLM chat with voice input — monorepo (frontend + core)",
  "scripts": {
    "dev:core": "npm run dev --prefix core",
    "dev:frontend": "npm run dev --prefix frontend",
