# ─────────────────────────────────────────────────────
# Ollama (local)
# ─────────────────────────────────────────────────────
# Base URL for the local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Chat model. Native tool-calling works best with qwen2.5, llama3.2, etc.
# DeepSeek-R1-Distill-Qwen-1.5B DOES NOT support tool-calling via Ollama's
# default template — see README "Known Limitations" #1.
OLLAMA_MODEL=erwan2/DeepSeek-R1-Distill-Qwen-1.5B

# Embedding model (must be 768-dim to match the DB schema).
# nomic-embed-text is highly recommended and widely available.
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─────────────────────────────────────────────────────
# Postgres (existing instance, pgvector extension required)
# Run once as superuser: CREATE EXTENSION IF NOT EXISTS vector;
# ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/local_llm_agent

# ─────────────────────────────────────────────────────
# Exa MCP (web search)
# Obtain at: https://exa.ai
# ─────────────────────────────────────────────────────
EXA_API_KEY=your_exa_api_key_here

# ─────────────────────────────────────────────────────
# Orchestrator tuning
# ─────────────────────────────────────────────────────
# Maximum ToolLoopAgent steps per conversation turn
MAX_STEPS=15

# Number of semantic memory items retrieved per turn
MEMORY_TOP_K=5

# Consolidate memory after every N saved messages
CONSOLIDATION_INTERVAL=20
