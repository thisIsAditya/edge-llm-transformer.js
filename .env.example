# Used by docker-compose.yml. Copy to .env and fill in.

# Required. Get one at https://exa.ai
EXA_API_KEY=your_exa_api_key_here

# "ollama" (runs in the compose stack) or "anthropic".
# Embeddings always use Ollama, so the ollama service starts either way.
MODEL_PROVIDER=ollama
OLLAMA_MODEL=erwan2/DeepSeek-R1-Distill-Qwen-1.5B
OLLAMA_EMBED_MODEL=nomic-embed-text

# Only needed when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

POSTGRES_PASSWORD=postgres
WEB_PORT=8080

# Browser Whisper. Leave blank for onnx-community/whisper-base.en from the Hugging Face Hub.
# To use a fine-tuned ONNX export, put it in frontend/public/models/<id>/, then set the id
# and VITE_ASR_LOCAL_MODELS=true. These are baked into the frontend image, so rebuild after
# changing them: docker compose up -d --build frontend
VITE_ASR_MODEL_ID=
VITE_ASR_LOCAL_MODELS=false
